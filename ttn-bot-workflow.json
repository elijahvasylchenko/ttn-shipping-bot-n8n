    {
      "parameters": {
        "jsCode": "// Build combined ZPL for all orders\nconst inputData = $input.all()[0].json;\nconst orderIds = inputData.order_id || [];\nconst ttns = inputData.ttn || [];\nconst productNames = inputData.product_name || [];\n\nlet combinedZpl = '';\n\nfor (let i = 0; i < orderIds.length; i++) {\n    const orderId = orderIds[i] || '000';\n    const ttn = ttns[i] || 'TTN not found';\n    const productName = productNames[i] || 'No products';\n\n    combinedZpl += `^XA\n^CI28\n^CF0,40\n^FO50,50^FDOrder: #${orderId}^FS\n^CF0,80\n^FO50,150^FD${ttn}^FS\n^CF0,40\n^FO50,280^FB600,4,,L^FDProducts: ${productName}^FS\n^XZ\\n`;\n}\n\nreturn { \n  zpl_code: combinedZpl, \n  count: orderIds.length \n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
